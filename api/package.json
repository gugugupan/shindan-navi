{
  "name": "shindan-navi-events-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../dist && node scripts/import-events.mjs && wrangler dev --local --config ../wrangler.jsonc",
    "dev:node": "mkdir -p ../dist && node scripts/import-events.mjs --target sqlite && node scripts/dev-node.mjs",
    "import": "node scripts/import-events.mjs",
    "import:sqlite": "node scripts/import-events.mjs --target sqlite",
    "import:remote": "node scripts/import-events.mjs --target remote",
    "db:migrate": "wrangler d1 migrations apply shindan-navi-events --local --config ../wrangler.jsonc",
    "db:reset": "rm -rf ../.wrangler/state/v3/d1 .wrangler/state/v3/d1 .local/events.sqlite3*",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle": "mkdir -p ../dist && wrangler deploy --dry-run --config ../wrangler.jsonc --outdir \"$PWD/.local/bundle\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}

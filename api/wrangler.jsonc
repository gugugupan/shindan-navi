// LOCAL ONLY. database_id is a placeholder: no remote D1 exists. Do not deploy this config;
// `wrangler dev` (local by default) and `wrangler d1 ... --local` never use the id.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shindan-navi-events-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shindan-navi-events",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "dev": { "port": 8787 }
}

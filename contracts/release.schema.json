{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shindan-navi.app/contracts/release.schema.json",
  "title": "Release records (one file data/releases/<source>/latest.json; see releases.md)",
  "description": "cardlabo and torecamap files hold aggregator records, the official file official records. Array order is page order and is significant.",
  "type": "array",
  "minItems": 1,
  "items": { "oneOf": [{ "$ref": "#/definitions/aggregator" }, { "$ref": "#/definitions/official" }] },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nullableText": { "type": ["string", "null"] },
    "nullableYen": { "type": ["integer", "null"], "minimum": 1 },
    "nullableCount": { "type": ["integer", "null"], "minimum": 1, "maximum": 999 },
    "aggregator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "game", "name", "pack", "box", "url", "img", "src"],
      "properties": {
        "date": { "$ref": "#/definitions/date" },
        "game": { "type": "string", "description": "Display title via GAME; an unknown source label is kept as-is." },
        "name": { "type": "string", "minLength": 1 },
        "pack": { "type": "string", "description": "Price text as written by the source, \"\" if none." },
        "box": { "type": "string", "description": "Box price text (トレカの地図 only), \"\" if none." },
        "url": { "type": "string", "description": "Product link, \"\" if none." },
        "img": { "type": "string", "description": "Image URL, \"\" if none or a placeholder." },
        "src": { "enum": ["clabo", "torecamap"] }
      }
    },
    "official": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key", "game", "name", "date", "date_text", "source_page", "url", "image", "pack_yen", "box_yen",
                   "per_box", "per_pack", "type", "tentative", "editions", "kind", "kind_p", "via", "source"],
      "properties": {
        "source_key": { "type": "string", "description": "Key in scripts/official/sources.json." },
        "game": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "date": { "oneOf": [{ "$ref": "#/definitions/date" }, { "type": "null" }] },
        "date_text": { "$ref": "#/definitions/nullableText" },
        "source_page": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/definitions/nullableText" },
        "image": { "$ref": "#/definitions/nullableText" },
        "pack_yen": { "$ref": "#/definitions/nullableYen" },
        "box_yen": { "$ref": "#/definitions/nullableYen" },
        "per_box": { "$ref": "#/definitions/nullableCount" },
        "per_pack": { "$ref": "#/definitions/nullableCount" },
        "type": { "$ref": "#/definitions/nullableText" },
        "tentative": { "type": "boolean" },
        "editions": { "type": "array", "items": { "type": "string" } },
        "kind": { "enum": ["BOOSTER_PACK", "DECK", "PRODUCT_SET_OR_BOX", "SUPPLY_OR_ACCESSORY"] },
        "kind_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "via": { "enum": ["pokemon_api", "records", "listing", "news"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "key", "site"],
          "description": "make_source(final_url(url or source_page), name, 'official'), computed by the collector.",
          "properties": {
            "url": { "type": "string" },
            "key": { "type": "string" },
            "site": { "const": "official" }
          }
        }
      }
    }
  }
}

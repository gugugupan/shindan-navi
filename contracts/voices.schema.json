{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shindan-navi.app/contracts/voices.schema.json",
  "title": "話題カレンダー snapshot (<YYYY-MM-DD>.json, local only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "date", "window", "topics"],
  "properties": {
    "version": { "const": 1 },
    "date": { "$ref": "#/definitions/date", "description": "Snapshot date (Asia/Tokyo) = window.to = the file name." },
    "window": { "$ref": "#/definitions/window" },
    "sample": { "type": "boolean", "description": "true: hand-made sample for the UI. Dropped from the build once a real snapshot exists." },
    "note": { "type": "string", "description": "For people reading the file; never shown." },
    "topics": { "type": "array", "items": { "$ref": "#/definitions/topic" } }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "window": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/definitions/date" }, "to": { "$ref": "#/definitions/date" } },
      "description": "Inclusive JST dates of the posts the snapshot looked at."
    },
    "xpost": { "type": "string", "pattern": "^https://x\\.com/[A-Za-z0-9_]{1,15}/status/\\d{1,20}$" },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "game", "title", "summary", "attitude", "share", "volume", "voices", "reacting_to", "window", "first_seen", "status", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$", "description": "Stable across snapshots while the topic continues." },
        "game": { "type": "string", "pattern": "^[A-Z]{2,6}$", "description": "Game code: an /events/ code (OPCG, PTCG, …) or MTG / YGO / DM; list in contracts/voices.md." },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 160, "description": "Our own words, 1-2 sentences." },
        "attitude": { "enum": ["positive", "negative", "mixed", "neutral"] },
        "share": {
          "type": "object", "additionalProperties": false, "required": ["positive", "negative", "neutral"],
          "properties": {
            "positive": { "type": "integer", "minimum": 0 },
            "negative": { "type": "integer", "minimum": 0 },
            "neutral": { "type": "integer", "minimum": 0 }
          },
          "description": "Counts of the posts behind the topic (not weights: a total below 5 is shown as a small sample); at least one is > 0."
        },
        "volume": { "enum": ["high", "mid", "low"] },
        "voices": {
          "type": "array", "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": "2-3 short paraphrased opinions in our own words, never post text. May be empty when none were paraphrased."
        },
        "reacting_to": { "oneOf": [{ "$ref": "#/definitions/xpost" }, { "type": "null" }], "description": "Official (game / brand account) post the topic reacts to; the only X link a topic carries." },
        "window": { "$ref": "#/definitions/window" },
        "first_seen": { "$ref": "#/definitions/date" },
        "status": { "enum": ["new", "continuing", "cooling"] },
        "source": { "enum": ["grok-app", "openrouter", "x-api"] }
      }
    }
  }
}

// One Worker serves the static site (dist/) and the events API (/api/*, D1).
// database_id is a placeholder and must stay one: the real id comes from the D1_DATABASE_ID secret / env
// var via `node api/scripts/remote-config.mjs`, which writes the git-ignored wrangler.remote.json used
// for deploys and remote D1 commands. Local commands (`wrangler dev`, `d1 ... --local`) never read the id.
// Full-line // comments only: remote-config.mjs strips them to parse this file without dependencies.
{
  "$schema": "api/node_modules/wrangler/config-schema.json",
  "name": "shindan-navi",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-07-01",
  // No public workers.dev site; version preview URLs (workers.dev) stay on for checking deploys before
  // they go live. Static responses on *.workers.dev carry X-Robots-Tag: noindex (public/_headers).
  // No routes here: the shindan-navi.app custom domain is added only by `remote-config.mjs --domain`.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shindan-navi-events",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "api/migrations"
    }
  ],
  // Counted only on cache misses (the requests that read D1), per Cloudflare location: API_LIMIT per client
  // (IPv4 address / IPv6 /64), API_BREAKER for everyone together. namespace_id only has to be unique in the account.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "71101", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_BREAKER", "namespace_id": "71102", "simple": { "limit": 300, "period": 60 } },
    // Accounts: login start/callback per client, prefs writes and account deletion per user.
    { "name": "AUTH_LIMIT", "namespace_id": "71103", "simple": { "limit": 30, "period": 60 } }
  ],
  // Login, cookies and CSRF checks derive from SITE_ORIGIN, never from Host; on any other origin (workers.dev
  // previews, wrangler dev) the account routes answer 404. Secrets (wrangler secret put): GOOGLE_OAUTH_CLIENT_ID,
  // GOOGLE_OAUTH_CLIENT_SECRET, SESSION_SECRET; without all three the account routes answer 404 as well.
  "vars": { "SITE_ORIGIN": "https://shindan-navi.app" },
  "dev": { "port": 8787 }
}
